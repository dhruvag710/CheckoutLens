	column 'Strict Conversion Rate' =
			
			DIVIDE(DeviceFunnel[overall_strict_cr_pct], 100)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3f0291c6-9c7c-4a8d-8dc4-cd2fae207202
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	measure 'Total Product Views' = SUM(DeviceFunnel[sessions_view_item])
		formatString: #,0
		lineageTag: 10000001-0000-0000-0000-000000000001

	measure 'Total Checkout Starts' = SUM(DeviceFunnel[sessions_begin_checkout])
		formatString: #,0
		lineageTag: 10000002-0000-0000-0000-000000000002

	measure 'Total Strict Purchases' = SUM(DeviceFunnel[sessions_purchase_strict])
		formatString: #,0
		lineageTag: 10000003-0000-0000-0000-000000000003

	measure 'Strict Conversion Rate (Overall)' = DIVIDE(SUM(DeviceFunnel[sessions_purchase_strict]), SUM(DeviceFunnel[sessions_view_item]))
		formatString: 0.00%
		lineageTag: 10000004-0000-0000-0000-000000000004

	measure 'Macro Checkout Completion Rate (Overall)' = DIVIDE(SUM(DeviceFunnel[sessions_purchase_macro]), SUM(DeviceFunnel[sessions_begin_checkout]))
		formatString: 0.00%
		lineageTag: 10000005-0000-0000-0000-000000000005

